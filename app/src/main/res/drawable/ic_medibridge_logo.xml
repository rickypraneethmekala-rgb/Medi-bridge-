        android:strokeColor="#1500B4D8" />

    <!-- 1. BRIDGE SUSPENSION TOWERS & CABLES -->
    <group
        android:translateX="0"
        android:translateY="0">

        <!-- Vertical Suspender Wires -->
        <path
            android:strokeColor="#00A896"
            android:strokeWidth="1.2"
            android:strokeAlpha="0.75"
            android:strokeLineCap="round"
            android:pathData="M32,48 L32,60 M38,41 L38,59 M44,35 L44,58 M50,32 L50,57 M56,41 L56,56 M64,48 L64,55 M72,41 L72,56 M78,32 L78,57 M84,35 L84,58 M90,41 L90,59 M96,48 L96,60" />

        <!-- Main Suspension Swooping Cables -->
        <path
            android:strokeWidth="2.5"
            android:strokeLineCap="round"
            android:fillColor="#00000000"
            android:pathData="M28,52 Q38,36 48,28 L51,28 Q64,45 77,28 L80,28 Q90,36 100,52">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:startX="28"
                    android:startY="52"
                    android:endX="100"
                    android:endY="52"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#00A896" />
                    <item android:offset="0.5" android:color="#0A3981" />
                    <item android:offset="1.0" android:color="#00A896" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Left Suspension Tower -->
        <path
            android:pathData="M47,27 L51,27 L52.5,66 L45.5,66 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="47"
                    android:startY="27"
                    android:endX="52"
                    android:endY="66"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#00E5FF" />
                    <item android:offset="0.5" android:color="#00838F" />
                    <item android:offset="1.0" android:color="#0A3981" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Right Suspension Tower -->
        <path
            android:pathData="M77,27 L81,27 L82.5,66 L75.5,66 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="77"
                    android:startY="27"
                    android:endX="82"
                    android:endY="66"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#00E5FF" />
                    <item android:offset="0.5" android:color="#00838F" />
                    <item android:offset="1.0" android:color="#0A3981" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Dynamic Arch Bridge Deck -->
        <path
            android:pathData="M26,63 Q64,52 102,63 L102,68 Q64,57 26,68 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="26"
                    android:startY="60"
                    android:endX="102"
                    android:endY="68"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#00B4D8" />
                    <item android:offset="0.5" android:color="#0A3981" />
                    <item android:offset="1.0" android:color="#00B4D8" />
                </gradient>
            </aapt:attr>
        </path>
    </group>

    <!-- 2. MEDICAL CROSS WITH ECG PULSE (TOP CENTER) -->
    <group
        android:translateX="0"
        android:translateY="0">

        <!-- Rounded Medical Cross -->
        <path
            android:pathData="M59,16 C59,14.9 59.9,14 61,14 L67,14 C68.1,14 69,14.9 69,16 L69,25 L78,25 C79.1,25 80,25.9 80,27 L80,33 C80,34.1 79.1,35 78,35 L69,35 L69,44 C69,45.1 68.1,46 67,46 L61,46 C59.9,46 59,45.1 59,44 L59,35 L50,35 C48.9,35 48,34.1 48,33 L48,27 C48,25.9 48.9,25 50,25 L59,25 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="48"
                    android:startY="14"
                    android:endX="80"
                    android:endY="46"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#00E5FF" />
                    <item android:offset="0.6" android:color="#00A896" />
                    <item android:offset="1.0" android:color="#028090" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Glowing White Pulse ECG Line across Cross -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="2.0"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000"
            android:pathData="M46,30 L57,30 L60.5,21 L64.5,39 L68,26 L70.5,30 L82,30" />
    </group>

    <!-- 3. BOTTOM CARING HANDS EMBRACE + HEART + PLUS -->
    <group
        android:translateX="0"
        android:translateY="0">

        <!-- Flowing Supportive Hands -->
        <path
            android:pathData="M28,68 C28,68 36,83 48,90 C56,94 61,94 64,94 C67,94 72,94 80,90 C92,83 100,68 100,68 C100,68 94,88 80,97 C70,102 58,102 48,97 C34,88 28,68 28,68 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="28"
                    android:startY="68"
                    android:endX="100"
                    android:endY="102"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#00B4D8" />
                    <item android:offset="0.5" android:color="#0A3981" />
                    <item android:offset="1.0" android:color="#00B4D8" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Central Healthcare Heart -->
        <path
            android:pathData="M64,84 C64,84 57,77 57,73 C57,70 59.5,68 62,68 C63.5,68 64,68.8 64,68.8 C64,68.8 64.5,68 66,68 C68.5,68 71,70 71,73 C71,77 64,84 64,84 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="57"
                    android:startY="68"
                    android:endX="71"
                    android:endY="84"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#00E5FF" />
                    <item android:offset="1.0" android:color="#00897B" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- White Medical Plus in Heart -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M63.2,71.5 h1.6 v1.8 h1.8 v1.6 h-1.8 v1.8 h-1.6 v-1.8 h-1.8 v-1.6 h1.8 z" />
    </group>

    <!-- MediBridge+ Brand Typography Base -->
    <group
        android:translateX="0"
        android:translateY="0">
        <!-- Subtle Accent Dot -->
        <path
            android:fillColor="#00E5FF"
            android:pathData="M64,107 A2,2 0 1,0 64,111 A2,2 0 1,0 64,107 Z" />
    </group>

</vector>
