        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="64"
                android:startY="8"
                android:endX="64"
                android:endY="120"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFFFF" />
                <item android:offset="1.0" android:color="#F0F9FA" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle Ambient Radial Glow inside Badge -->
    <path
        android:pathData="M64,20 A44,44 0 1,0 64,108 A44,44 0 1,0 64,20 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="64"
                android:startY="64"
                android:endX="108"
                android:endY="108"
                android:type="radial"
                android:gradientRadius="44">
                <item android:offset="0.0" android:color="#1A00E5FF" />
                <item android:offset="1.0" android:color="#0000E5FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Outer Decorative Modern Border -->
    <path
        android:pathData="M24,8 C14,8 8,14 8,24 L8,104 C8,114 14,120 24,120 L104,120 C114,120 120,114 120,104 L120,24 C120,14 114,8 104,8 Z"
